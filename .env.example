# Base URL of the LeadIQ backend API (include the /api suffix).
VITE_API_BASE_URL=http://localhost:3000/api

# Data mode:
#   auto  -> try the API, fall back to local browser storage if unreachable (default)
#   api   -> always use the backend API
#   local -> always use local browser storage (demo mode, no backend required)
VITE_DATA_MODE=auto
